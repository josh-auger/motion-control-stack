FROM shared-base-build:devel AS base

ARG THREADS=1
ENV DEBIAN_FRONTEND=noninteractive
ENV GIT_HTTP_MAX_REQUEST_BUFFER=100M

# STAGE 1: COMPILE ISMRMRD AND SIEMENS LIBS
# ============================================================
RUN mkdir -p /opt/code

RUN cd /opt/code && \
    git clone https://github.com/ismrmrd/ismrmrd.git && \
    cd ismrmrd && \
    git checkout v1.13.4 && \
    sed -i '1i #include <cstdint>' include/ismrmrd/xml.h && \
    mkdir build && cd build && \
    cmake .. && \
    make -j${THREADS} && \
    make install

RUN cd /opt/code && \
    git clone https://github.com/ismrmrd/siemens_to_ismrmrd.git && \
    cd siemens_to_ismrmrd && \
    git checkout v1.2.10 && \
    mkdir build && cd build && \
    cmake .. && \
    make -j${THREADS} && \
    make install

RUN cd /opt/code && \
    git clone https://github.com/ismrmrd/ismrmrd-python-tools.git && \
    cd ismrmrd-python-tools && \
    pip3 install --break-system-packages --no-cache-dir .


# STAGE 2: COMPILE C++ DEPENDENCIES (ITK / NLOPT / QUILL)
# ============================================================
WORKDIR /usr/src

# JDA: Stale ITK build since SimpleITK SuperBuild will also build ITK. Keep suppressed for now until confirmed.
# # ITK library
# RUN mkdir itksrc && cd itksrc && \
#     git clone --depth 1 -b v5.4.0 https://github.com/InsightSoftwareConsortium/ITK ITK && \
#     mkdir build && cd build && \
#     cmake -DCMAKE_INSTALL_PREFIX=/opt/itk \
#           -DBUILD_TESTING=OFF \
#           -DBUILD_EXAMPLES=OFF \
#           ../ITK && \
#     make -j${THREADS} && make install

# ENV ITK_DIR=/opt/itk/lib/cmake/ITK-5.4

# NLOPT library
RUN mkdir -p /usr/src/nlopt && cd /usr/src/nlopt && \
    git clone -b v2.7.0 https://github.com/stevengj/nlopt . && \
    mkdir build && cd build && \
    cmake -DCMAKE_INSTALL_PREFIX=/opt/nlopt \
          -DBUILD_SHARED_LIBS=OFF \
          .. && \
    make -j${THREADS} && \
    make install

ENV NLOPT_DIR=/opt/nlopt/lib/cmake/nlopt

# Quill logger library
RUN cd /usr/src && \
    git clone https://github.com/odygrd/quill.git && \
    cd quill && \
    mkdir build && cd build && \
    cmake -DCMAKE_INSTALL_PREFIX=/opt/quill .. && \
    make -j${THREADS} && make install


# CUDA samples (provides helper_math.h)
# ============================================================
RUN git clone --depth 1 \
    https://github.com/NVIDIA/cuda-samples.git \
    /opt/cuda-samples

# CUDA samples helper_math.h compatibility
# ============================================================
RUN mkdir -p /usr/local/cuda/samples/common/inc && \
    ln -s /opt/cuda-samples/Common/helper_math.h \
    /usr/local/cuda/samples/common/inc/helper_math.h

# SimpleITK library for SLIMM
# ============================================================
RUN mkdir -p /opt/simpleitk && \
    cd /opt/simpleitk && \
    git clone --depth 1 \
    --branch v2.5.5 \
    https://github.com/SimpleITK/SimpleITK.git

RUN mkdir -p /opt/simpleitk/build && \
    cd /opt/simpleitk/build && \
    cmake ../SimpleITK/SuperBuild \
          -DBUILD_TESTING=OFF && \
    make -j${THREADS}

ENV SimpleITK_DIR=/opt/simpleitk/build/SimpleITK-build
ENV ITK_DIR=/opt/simpleitk/build/ITK-prefix/lib/cmake/ITK


# STAGE 3a: SLIMM CUDA STANDALONE REGISTRATION
# ============================================================
RUN apt-get update && apt-get install -y \
    libceres-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    curl \
    && rm -rf /var/lib/apt/lists/

# ACE library
RUN mkdir -p /opt/ace-src && cd /opt/ace-src && \
    curl -L -O https://github.com/DOCGroup/ACE_TAO/releases/download/ACE%2BTAO-8_0_6/ACE-8.0.6.tar.gz && \
    tar zxf ACE-8.0.6.tar.gz

ENV ACE_ROOT=/opt/ace-src/ACE_wrappers
ENV ACE_INSTALL_DIR=/opt/ace

RUN cd ${ACE_ROOT}/ace && cp config-linux.h config.h

RUN cd ${ACE_ROOT} && \
    cp include/makeinclude/platform_linux.GNU \
       include/makeinclude/platform_macros.GNU

RUN cd ${ACE_ROOT} && \
    echo "INSTALL_PREFIX=/opt/ace" >> include/makeinclude/platform_macros.GNU

RUN cd ${ACE_ROOT}/ace && \
    make -j${THREADS} && \
    make install

# Compile standalone SLIMM-v3 executable
COPY --from=slimm . /opt/code/SLIMM-v3

RUN mkdir -p /opt/code/SLIMM-v3/build && \
    cd /opt/code/SLIMM-v3/build && \
    cmake ../src/registration \
        -DSimpleITK_DIR=${SimpleITK_DIR} \
        -DITK_DIR=${ITK_DIR} && \
    make -j${THREADS}


# STAGE 3: COMPILE SMS-MI-REG
# ============================================================
RUN mkdir -p /usr/src/moco
COPY ../external/sms-mi-reg-jauger /usr/src/moco

ENV PATH="/usr/src/moco:${PATH}"

RUN cd /usr/src/moco && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/opt/moco \
          . && \
    make -j${THREADS} && \
    mkdir -p /opt/moco/bin && \
    cp /usr/src/moco/sms-mi-reg /opt/moco/bin/

# Copy GPU-accelerated SLIMM-v3 registration binary into moco bin directory
RUN cp /opt/code/SLIMM-v3/build/cuda-standalone-registration \
       /opt/moco/bin/

ENV MOCO_DIR=/opt/moco/lib/cmake/moco

# FINAL RUNTIME IMAGE
# ============================================================
FROM shared-base-build:runtime AS runtime

# runtime environment
# ENV LD_LIBRARY_PATH=/opt/itk/lib:/opt/nlopt/lib:/opt/moco/lib:${LD_LIBRARY_PATH}
ENV LD_LIBRARY_PATH=/opt/nlopt/lib:/opt/moco/lib:${LD_LIBRARY_PATH}
ENV PATH=/opt/moco/bin:${PATH}

# ISMRMRD artifacts
COPY --from=base /usr/local/include/ismrmrd /usr/local/include/ismrmrd/
COPY --from=base /usr/local/share/ismrmrd /usr/local/share/ismrmrd/
COPY --from=base /usr/local/bin /usr/local/bin/
COPY --from=base /usr/local/lib /usr/local/lib

# C++ installs
# COPY --from=base /opt/itk /opt/itk
COPY --from=base /opt/nlopt /opt/nlopt
COPY --from=base /opt/quill /opt/quill
COPY --from=base /opt/moco /opt/moco
COPY --from=base /opt/ace /opt/ace

# APPLICATIONS
COPY ../apps/python_fire_server     /opt/apps/fire_server
COPY ../apps/motion_monitor         /opt/apps/motion_monitor
COPY ../apps/queue_processor        /opt/apps/queue_processor
COPY ../shared                      /opt/shared

# ENTRYPOINT
COPY ./docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /opt/apps/fire_server

ENTRYPOINT ["/entrypoint.sh"]
