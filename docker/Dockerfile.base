ARG CUDA_VERSION=13.2.0
ARG UBUNTU_VERSION=24.04

# ---------- shared setup, parameterized by target ----------
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS build-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Locale configuration
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    apt-get install -y \
        locales \
        locales-all && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8
ENV MPLCONFIGDIR=/tmp/matplotlibdir

# Shared build dependencies + Python 3.12
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    zip \
    perl \
    bison \
    flex \
    gperf \
    ca-certificates \
    gnupg2 \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Runtime libraries
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libhdf5-103-1t64 \
    libxml2 \
    libxslt1.1 \
    libjpeg-turbo8 \
    libpng16-16 \
    libtiff6 \
    libsqlite3-0 \
    zlib1g \
    liblzma5 \
    libgomp1 \
    libfreetype6 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# Development libraries
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y \
    libhdf5-dev \
    libxml2-dev \
    libxslt1-dev \
    libboost-all-dev \
    libfftw3-dev \
    libpugixml-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libsuitesparse-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libproj-dev \
    libceres-dev \
    && rm -rf /var/lib/apt/lists/*

# Verify Python environment
RUN python3 --version && \
    python3 -m pip --version

COPY requirements.txt /tmp/requirements.txt

RUN python3 -m pip install --no-cache-dir \
    --break-system-packages \
    -r /tmp/requirements.txt

WORKDIR /app


# ---------- lean runtime variant ----------
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Locale + Python runtime
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y \
    locales \
    locales-all \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 --version && \
    python3 -m pip --version

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8
ENV MPLCONFIGDIR=/tmp/matplotlibdir

# NVIDIA runtime configuration
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Runtime shared libraries only
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libhdf5-103-1t64 \
    libxml2 \
    libxslt1.1 \
    libjpeg-turbo8 \
    libpng16-16 \
    libtiff6 \
    libsqlite3-0 \
    zlib1g \
    liblzma5 \
    libgomp1 \
    libfreetype6 \
    libfontconfig1 \
    libceres4t64 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt

RUN python3 -m pip install --no-cache-dir \
    --break-system-packages \
    -r /tmp/requirements.txt

WORKDIR /app
